#. Plugin Name of the plugin
#: beltoft-lightweight-cache.php
msgid "Beltoft Lightweight Cache"
msgstr "Beltoft Lightweight Cache"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: beltoft-lightweight-cache.php
msgid "https://beltoft.net/"
msgstr ""

#. Description of the plugin
#: beltoft-lightweight-cache.php
msgid "Page cache controls for a server that caches pages in nginx: marks the pages that may be cached, clears them when content changes, and adds a Clear cache button."
msgstr "Styring af sidecache for en server, der cacher sider i nginx: markerer de sider, der må caches, rydder dem, når indhold ændres, og tilføjer en knap til at rydde cachen."

#. Author of the plugin
#: beltoft-lightweight-cache.php
msgid "beltoft.net"
msgstr ""

#: src/Admin.php:38
#: src/Admin.php:39
#: src/Admin.php:165
msgid "Lightweight Cache"
msgstr "Lightweight Cache"

#: src/Admin.php:69
msgid "Settings"
msgstr "Indstillinger"

#: src/Admin.php:94
#: src/Admin.php:193
#: src/Admin.php:195
msgid "Clear cache"
msgstr "Ryd cache"

#: src/Admin.php:105
msgid "You do not have permission to do this."
msgstr "Du har ikke tilladelse til dette."

#: src/Admin.php:145
msgid "Cache cleared."
msgstr "Cachen er ryddet."

#: src/Admin.php:150
msgid "The object cache was cleared. The page cache was not: clearing is not set up on this server."
msgstr "Objektcachen er ryddet. Sidecachen er ikke ryddet: rydning er ikke sat op på denne server."

#: src/Admin.php:171
msgid "Page cache"
msgstr "Sidecache"

#: src/Admin.php:175
msgid "Let the server cache pages for visitors who are not signed in"
msgstr "Lad serveren cache sider for besøgende, der ikke er logget ind"

#: src/Admin.php:180
msgid "Keep a page cached for"
msgstr "Behold en side i cachen i"

#: src/Admin.php:194
msgid "Removes every cached page and flushes the object cache."
msgstr "Fjerner alle cachede sider og tømmer objektcachen."

#: src/Admin.php:197
msgid "Status"
msgstr "Status"

#: src/Admin.php:203
msgid "Page cache: on."
msgstr "Sidecache: til."

#: src/Admin.php:204
msgid "Page cache: off. No page is marked for caching."
msgstr "Sidecache: fra. Ingen sider markeres til caching."

#: src/Admin.php:211
msgid "Automatic clearing: not set up on this server."
msgstr "Automatisk rydning: ikke sat op på denne server."

#. translators: %s: the name of the clearing method.
#: src/Admin.php:214
#, php-format
msgid "Automatic clearing: on, by %s."
msgstr "Automatisk rydning: til, via %s."

#: src/Admin.php:222
msgid "Object cache: in use."
msgstr "Objektcache: i brug."

#: src/Admin.php:223
msgid "Object cache: not in use."
msgstr "Objektcache: ikke i brug."

#: src/Admin.php:229
msgid "What is cached"
msgstr "Hvad der caches"

#: src/Admin.php:230
msgid "Cached: pages for visitors who are not signed in. A cached page is cleared when you change the content it shows."
msgstr "Caches: sider for besøgende, der ikke er logget ind. En cachet side ryddes, når du ændrer det indhold, den viser."

#: src/Admin.php:231
msgid "Never cached: signed-in users, the admin area, carts, checkout and account pages, searches, previews, error pages, pages that set a cookie, and requests with a query string (tracking parameters excepted)."
msgstr "Caches aldrig: loggede ind brugere, administrationsområdet, kurve, kassen og kontosider, søgninger, forhåndsvisninger, fejlsider, sider der sætter en cookie, og forespørgsler med en forespørgselsstreng (sporingsparametre undtaget)."

#: src/Admin.php:232
msgid "To use another caching plugin, switch the page cache off here or deactivate this plugin."
msgstr "Hvis du vil bruge et andet cacheplugin, så slå sidecachen fra her eller deaktiver dette plugin."

#: src/Admin.php:235
msgid "Automatic clearing"
msgstr "Automatisk rydning"

#: src/Admin.php:236
msgid "Pages are marked for caching, but this server has no way set up to clear them when content changes, so a changed page can stay cached until its time is up. The server needs this configuration, and one of the constants BELTOFT_LWC_PURGE_SPOOL (a folder that a process with the right to delete reads) or BELTOFT_LWC_CACHE_PATH (the cache folder, when PHP may delete in it) in wp-config.php."
msgstr "Sider markeres til caching, men serveren har ingen måde sat op til at rydde dem, når indhold ændres, så en ændret side kan blive i cachen, til tiden er udløbet. Serveren skal have denne konfiguration og en af konstanterne BELTOFT_LWC_PURGE_SPOOL (en mappe, som en proces med ret til at slette læser) eller BELTOFT_LWC_CACHE_PATH (cachemappen, når PHP må slette i den) i wp-config.php."

